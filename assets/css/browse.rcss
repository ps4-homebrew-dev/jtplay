/*
 * The content browser: a list with an info panel, or (#browse.grid) a
 * wall of artwork tiles with the focused item's facts along the bottom.
 * Row and tile sizes must stay in sync with kEntryRowPitch, kGridColumns
 * and kGridRowPitch in src/app_internal.h.
 */

#entries {
	flex: 3;
	margin-right: 48px;
}

#details {
	flex: 2;
	padding-top: 52px; /* aligns with the first row, under the pane head */
}

/* ------------------------------------------------------------------ */
/* List                                                               */
/* ------------------------------------------------------------------ */

.entry-row {
	position: relative;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin-bottom: 6px;
	padding: 0px 20px 0px 10px;
	border-radius: 10px;
}

/* Thumbnail (or type glyph) at the start of the row. */
.entry-row .art-tile {
	width: 88px;
	height: 56px;
	margin-right: 20px;
	border-radius: 7px;
}

.entry-row .art-glyph {
	font-size: 28px;
}

/* The corner badges belong to tiles; a row says the same in line. */
.entry-row .art-check,
.entry-row .art-fav {
	display: none;
}

.entry-row .art-prog,
.entry-row .art-prog-bar {
	height: 4px;
}

.etitle {
	flex: 1;
	font-size: 28px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

.etitle.folder {
	font-weight: bold;
}

/* Favorite star / watched tick, between the title and the right column. */
.emark {
	margin-left: 14px;
	font-size: 22px;
	color: #e0b84d;
}

.emark.watched {
	color: #4dd6b8;
}

/* Kodi's "label2": the value the list is sorted by. */
.emeta {
	margin-left: 24px;
	font-size: 22px;
	color: #6f7b92;
	white-space: nowrap;
}

/* Focused row: the solid accent bar, dark text. */
.entry-row.selected {
	decorator: linear-gradient(90deg, #4dd6b8 0%, #38b89c 100%);
}
.entry-row.selected .etitle { color: #06231d; }
.entry-row.selected .emeta { color: #0d3d33; }
.entry-row.selected .emark { color: #06231d; }

/* ------------------------------------------------------------------ */
/* Grid                                                               */
/* ------------------------------------------------------------------ */

#browse.grid #details {
	display: none;
}

#browse.grid #entries {
	margin-right: 0px;
}

#browse.grid #entry-list {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	gap: 24px 24px;
	padding: 10px 6px 0px 6px;
}

/* A tile: art on top, title under it. 252px tall plus the 24px gap. */
#browse.grid .entry-row {
	flex-direction: column;
	align-items: stretch;
	width: 272px;
	height: 252px;
	margin: 0px;
	padding: 0px;
	border-radius: 0px;
	decorator: none;
	transform: scale(1);
	transition: transform 0.15s cubic-out;
}

#browse.grid .entry-row .art-tile {
	width: 272px;
	height: 176px;
	margin: 0px;
	border: 3px transparent;
	border-radius: 10px;
}

#browse.grid .entry-row .art-glyph {
	font-size: 64px;
}

#browse.grid .entry-row .art-check,
#browse.grid .entry-row .art-fav {
	display: block;
}

#browse.grid .entry-row .art-prog,
#browse.grid .entry-row .art-prog-bar {
	height: 6px;
}

#browse.grid .etitle {
	flex: 0;
	margin-top: 12px;
	font-size: 22px;
	text-align: center;
}

#browse.grid .emark,
#browse.grid .emeta {
	display: none;
}

#browse.grid .entry-row.selected {
	decorator: none;
	transform: scale(1.06);
}
#browse.grid .entry-row.selected .art-tile {
	border: 3px #4dd6b8;
	box-shadow: #4dd6b855 0px 0px 24px 0px;
}
#browse.grid .entry-row.selected .etitle {
	color: #ffffff;
	font-weight: bold;
}

/* The focused tile's facts, along the bottom of the wall. */
#grid-info {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin-top: 12px;
	padding: 0px 24px;
	background-color: #ffffff0a;
	border-radius: 12px;
}

.gi-title {
	flex: 1;
	font-size: 28px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
}

.gi-props {
	white-space: nowrap;
}

.gi-prop {
	margin-left: 28px;
	font-size: 22px;
	color: #aab6cc;
}

/* ------------------------------------------------------------------ */
/* Info panel                                                         */
/* ------------------------------------------------------------------ */

.detail-body {
	box-sizing: border-box;
	padding: 28px 32px;
	background-color: #0b1020b3;
	border-radius: 16px;
}

/* Fixed-height art box, so the text below does not jump around while the
 * selection moves between items with and without artwork. */
.detail-artbox {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	height: 400px;
	margin-bottom: 26px;
	background-color: #00000040;
	border-radius: 12px;
	overflow: hidden;
}

/* Cover art / thumbnail of the selected entry, scaled to fit the box with
 * its aspect ratio. */
.detail-art {
	display: block;
	max-width: 100%;
	max-height: 400px;
}

.detail-glyph {
	font-size: 150px;
	color: #4dd6b8;
	opacity: 0.6;
}

.detail-title {
	font-size: 34px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
}

.detail-fav {
	color: #e0b84d;
}

.detail-props {
	margin-top: 16px;
}

.prop {
	display: flex;
	flex-direction: row;
	padding: 6px 0px;
	border-bottom: 1px #ffffff0d;
}

.prop-label {
	width: 160px;
	font-size: 22px;
	color: #6f7b92;
}

.prop-value {
	flex: 1;
	font-size: 22px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

.detail-desc {
	margin-top: 18px;
	font-size: 23px;
	line-height: 1.5em;
	color: #aab6cc;
	white-space: pre-line;
	max-height: 230px;
	overflow: hidden;
}

/* Left / right in a list sorted by name jump a letter; the letter shows
 * large over the list for a moment. */
#entries {
	position: relative;
}
#jump-letter {
	z-index: 3;
	position: absolute;
	left: 50%;
	top: 40%;
	width: 180px;
	height: 180px;
	margin-left: -90px;
	margin-top: -90px;
	line-height: 180px;
	font-size: 110px;
	font-weight: bold;
	text-align: center;
	color: #06231d;
	background-color: #4dd6b8e8;
	border-radius: 28px;
	box-shadow: #000000a0 0px 20px 60px 0px;
}
