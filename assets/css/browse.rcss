/*
 * The sources view and the content browser. Row heights must stay in sync
 * with kSourceRowPitch / kEntryRowPitch in src/app_internal.h.
 */

/* ------------------------------------------------------------------ */
/* Sources                                                            */
/* ------------------------------------------------------------------ */

#sources {
	width: 1100px;
	margin-left: 338px; /* centered inside the 1776px content strip */
}

.source-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 96px;
	margin-bottom: 12px;
	padding: 0px 28px;
	background-color: #ffffff07;
	border: 2px transparent;
	border-radius: 14px;
}

.source-row.selected {
	background-color: #4dd6b82a;
	border: 2px #4dd6b8;
}

.srcicon {
	width: 72px;
	font-size: 44px;
	text-align: center;
	margin-right: 20px;
}

.srcinfo {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.srcname {
	font-size: 32px;
	font-weight: bold;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

.source-row.selected .srcname {
	color: #ffffff;
}

.srcdetail {
	margin-top: 4px;
	font-size: 22px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
}

/* ------------------------------------------------------------------ */
/* Entries                                                            */
/* ------------------------------------------------------------------ */

#entries {
	flex: 3;
	margin-right: 48px;
}

#details {
	flex: 2;
	padding-top: 56px; /* aligns with the first row, under the pane head */
}

.entry-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin-bottom: 6px;
	padding: 0px 24px;
	border: 2px transparent;
	border-radius: 10px;
}

.entry-row.selected {
	background-color: #4dd6b82a;
	border: 2px #4dd6b8;
}

.eicon {
	width: 52px;
	font-size: 30px;
	text-align: center;
	margin-right: 18px;
	opacity: 0.8;
}

.entry-row.selected .eicon {
	opacity: 1;
}

.etitle {
	flex: 1;
	font-size: 28px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

.entry-row.selected .etitle {
	color: #ffffff;
}

.entry-row.folder .etitle {
	font-weight: bold;
}

/* Kodi's "label2": the value the list is sorted by. */
.emeta {
	margin-left: 24px;
	font-size: 22px;
	color: #6f7b92;
	white-space: nowrap;
}

.entry-row.selected .emeta {
	color: #aab6cc;
}

/* ------------------------------------------------------------------ */
/* Info panel                                                         */
/* ------------------------------------------------------------------ */

.detail-body {
	box-sizing: border-box;
	padding: 32px 36px;
	background-color: #ffffff07;
	border-radius: 16px;
}

/* Fixed-height art box, so the text below does not jump around while the
 * selection moves between items with and without artwork. */
.detail-artbox {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	height: 420px;
	margin-bottom: 28px;
	background-color: #00000033;
	border-radius: 12px;
	overflow: hidden;
}

/* Cover art / thumbnail of the selected entry, scaled to fit the box with
 * its aspect ratio. */
.detail-art {
	display: block;
	max-width: 100%;
	max-height: 420px;
}

.detail-glyph {
	font-size: 150px;
	color: #4dd6b8;
	opacity: 0.6;
}

.detail-title {
	font-size: 34px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
}

.detail-props {
	margin-top: 18px;
}

.prop {
	display: flex;
	flex-direction: row;
	padding: 6px 0px;
	border-bottom: 1px #ffffff0d;
}

.prop-label {
	width: 160px;
	font-size: 22px;
	color: #6f7b92;
}

.prop-value {
	flex: 1;
	font-size: 22px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
}

.detail-desc {
	margin-top: 20px;
	font-size: 23px;
	line-height: 1.5em;
	color: #aab6cc;
	white-space: pre-line;
	max-height: 230px;
	overflow: hidden;
}
