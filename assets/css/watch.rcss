/*
 * Watch mode: hides the UI chrome so the video (drawn beneath the RmlUi
 * layer) shows through, with the OSD bar along the bottom. The bar's top
 * edge is the timeline: played in the accent, buffered ahead in a lighter
 * shade, a knob at the playhead, and a bubble with the target time while
 * seeking. For audio the bar stays up, with large cover art, over the
 * spectrum.
 */

/* Let the video drawn beneath the UI show through. */
body.watching {
	background-color: transparent;
	decorator: none;
}
body.watching #shell {
	display: none;
}

/* ------------------------------------------------------------------ */
/* OSD bar                                                            */
/* ------------------------------------------------------------------ */

#osd {
	z-index: 5;
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	box-sizing: border-box;
	padding: 38px 72px 44px 72px;
	background-color: #0a0e18f2;
	animation: 0.2s cubic-out osd-in;
}

@keyframes osd-in {
	from { transform: translateY(40px); opacity: 0; }
	to   { transform: translateY(0px); opacity: 1; }
}

/* The timeline, along the top edge. */
.osd-edge {
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 8px;
	background-color: #ffffff2e;
}

.osd-buffered,
.osd-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 8px;
}

.osd-buffered {
	background-color: #ffffff40;
}

.osd-played {
	decorator: linear-gradient(90deg, #2fa58c 0%, #4dd6b8 100%);
	box-shadow: #4dd6b880 0px 0px 14px 0px;
}

.osd-knob {
	position: absolute;
	top: -8px;
	width: 24px;
	height: 24px;
	margin-left: -12px;
	background-color: #ffffff;
	border: 5px #4dd6b8;
	border-radius: 12px;
	box-sizing: border-box;
}

/* Where a seek lands, over the knob's destination. */
.osd-seek {
	position: absolute;
	bottom: 24px;
	width: 200px;
	margin-left: -100px;
	padding: 8px 0px;
	font-size: 26px;
	font-weight: bold;
	text-align: center;
	color: #06231d;
	background-color: #4dd6b8;
	border-radius: 10px;
}

.osd-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.osd-art {
	display: block;
	width: 176px;
	max-height: 100px;
	margin-right: 32px;
	border-radius: 10px;
}

.osd-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.osd-title {
	font-size: 40px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
}

.osd-state {
	margin-right: 12px;
	font-size: 32px;
	color: #4dd6b8;
}

.osd-desc {
	margin-top: 4px;
	font-size: 24px;
	color: #aab6cc;
	white-space: nowrap;
	overflow: hidden;
}

.osd-tracks {
	display: flex;
	flex-direction: row;
	margin-top: 8px;
	white-space: nowrap;
	overflow: hidden;
}

.osd-track {
	margin-right: 14px;
	padding: 3px 12px;
	font-size: 19px;
	color: #aab6cc;
	background-color: #ffffff12;
	border-radius: 6px;
	white-space: nowrap;
}

.osd-next {
	margin-top: 12px;
	font-size: 22px;
	color: #aab6cc;
	white-space: nowrap;
	overflow: hidden;
}

.osd-next-label {
	margin-right: 14px;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
}

.osd-side {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	margin-left: 48px;
}

/* "12:34 / 45:00", one style throughout. */
.osd-time {
	font-size: 30px;
	color: #e8edf7;
	white-space: nowrap;
}

.osd-live {
	margin-left: 18px;
	padding: 3px 12px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #ffffff;
	background-color: #e04848;
	border-radius: 6px;
}

.osd-speed {
	margin-top: 8px;
}

.badge {
	display: inline-block;
	padding: 2px 10px;
	font-size: 20px;
	font-weight: bold;
	color: #06231d;
	background-color: #4dd6b8;
	border-radius: 6px;
}

/* ------------------------------------------------------------------ */
/* Audio: the now-playing card                                        */
/* ------------------------------------------------------------------ */

/* Frosted glass over the visualizer: the scene shows through, blurred,
 * so the card belongs to it without competing with it. */
#np-card {
	z-index: 5;
	position: absolute;
	left: 50%;
	top: 120px;
	box-sizing: border-box;
	width: 720px;
	margin-left: -360px;
	padding: 40px 48px 34px 48px;
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: #0a0e1899;
	backdrop-filter: blur(28px);
	border: 1px #ffffff1f;
	border-radius: 24px;
	box-shadow: #00000080 0px 24px 60px 0px;
}

.np-artbox {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	width: 260px;
	height: 260px;
	margin-bottom: 28px;
}

.np-art {
	display: block;
	max-width: 260px;
	max-height: 260px;
	border-radius: 16px;
	box-shadow: #000000a0 0px 14px 36px 0px;
}

.np-glyph {
	width: 220px;
	height: 220px;
	font-size: 110px;
	line-height: 220px;
	text-align: center;
	color: #4dd6b8;
	background-color: #4dd6b81f;
	border-radius: 20px;
}

.np-title {
	max-width: 624px;
	font-size: 38px;
	font-weight: bold;
	color: #ffffff;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

.np-meta {
	max-width: 624px;
	margin-top: 8px;
	font-size: 24px;
	color: #aab6cc;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

.np-track {
	margin-top: 14px;
	padding: 3px 12px;
	font-size: 18px;
	color: #aab6cc;
	background-color: #ffffff12;
	border-radius: 6px;
}

/* The same timeline as the video bar, as a slim bar across the card. */
.np-progress {
	position: relative;
	width: 100%;
	height: 6px;
	margin-top: 30px;
	background-color: #ffffff26;
	border-radius: 3px;
}

.np-buffered,
.np-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 6px;
	border-radius: 3px;
}

.np-buffered { background-color: #ffffff38; }
.np-played   { background-color: #4dd6b8; }

.np-knob {
	position: absolute;
	top: -6px;
	width: 18px;
	height: 18px;
	margin-left: -9px;
	box-sizing: border-box;
	background-color: #ffffff;
	border: 4px #4dd6b8;
	border-radius: 9px;
}

.np-status {
	margin-top: 16px;
	font-size: 24px;
	color: #e8edf7;
	white-space: nowrap;
}

.np-state {
	margin-right: 12px;
	color: #4dd6b8;
}

.np-status .badge {
	margin-left: 14px;
}

.np-live {
	margin-left: 14px;
	font-size: 18px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
}

.np-seek {
	margin-top: 10px;
	font-size: 22px;
	font-weight: bold;
	color: #4dd6b8;
}

.np-next {
	width: 100%;
	margin-top: 22px;
	padding-top: 18px;
	border-top: 1px #ffffff14;
	font-size: 22px;
	color: #aab6cc;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

.np-next-label {
	margin-right: 14px;
	font-size: 16px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
}

/* ------------------------------------------------------------------ */
/* Clock, pause badge, launch indicator                               */
/* ------------------------------------------------------------------ */

#osd-clock {
	z-index: 5;
	position: absolute;
	top: 36px;
	right: 64px;
	font-size: 52px;
	font-weight: bold;
	color: #ffffff;
	font-effect: shadow(2px 2px #000000b0);
}

#pause-badge {
	z-index: 5;
	position: absolute;
	left: 50%;
	top: 50%;
	width: 180px;
	height: 180px;
	margin-left: -90px;
	margin-top: -90px;
	font-size: 84px;
	line-height: 180px;
	text-align: center;
	color: #ffffff;
	background-color: #0a0e18b0;
	border-radius: 90px;
	animation: 0.2s cubic-out pause-in;
}

@keyframes pause-in {
	from { transform: scale(0.7); opacity: 0; }
	to   { transform: scale(1); opacity: 1; }
}

#launch-overlay {
	z-index: 5;
	position: absolute;
	top: 48px;
	left: 64px;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 14px 26px;
	background-color: #0a0e18cc;
	border-radius: 10px;
}

#launch-overlay .launch-label {
	margin-left: 10px;
	font-size: 24px;
	color: #e8edf7;
}

/* ------------------------------------------------------------------ */
/* Screensaver                                                        */
/* ------------------------------------------------------------------ */

#saver {
	z-index: 30;
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #000000f8;
}

.saver-box {
	position: absolute;
	width: 760px;
}

.saver-clock {
	font-size: 150px;
	font-weight: bold;
	color: #5a6478;
}

.saver-date {
	font-size: 34px;
	color: #3c4454;
}

.saver-now {
	margin-top: 28px;
	font-size: 30px;
	color: #3c4454;
	white-space: nowrap;
	overflow: hidden;
}
