/*
 * Watch mode: hides the UI chrome so the video (drawn beneath the RmlUi
 * layer) shows through, and styles the auto-hiding transport bar over it.
 * Audio playback keeps a persistent now-playing card instead. Both share
 * the timeline: state, elapsed, the bar, total.
 */

/* Let the video drawn beneath the UI show through. */
body.watching {
	background-color: transparent;
	decorator: none;
}
body.watching #shell {
	display: none;
}

/* ------------------------------------------------------------------ */
/* Timeline                                                           */
/* ------------------------------------------------------------------ */

.timeline {
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
}

.tl-state {
	width: 44px;
	font-size: 30px;
	color: #4dd6b8;
}

.tl-pos,
.tl-dur {
	font-size: 26px;
	color: #e8edf7;
	white-space: nowrap;
}

.tl-pos {
	min-width: 112px;
}

.tl-dur {
	min-width: 112px;
	text-align: right;
	color: #aab6cc;
}

/* The bar: what is buffered ahead in a lighter shade under what has been
 * played. Both children are positioned over the track, so the played part
 * always draws on top. */
.tl-track {
	position: relative;
	flex: 1;
	height: 10px;
	margin: 0px 24px;
	border-radius: 5px;
	background-color: #ffffff1f;
}

.tl-buffered,
.tl-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 10px;
	border-radius: 5px;
}

.tl-buffered {
	background-color: #ffffff33;
}

.tl-played {
	background-color: #4dd6b8;
}

.tl-live {
	flex: 1;
	margin-left: 24px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 4px;
	color: #ff6b6b;
}

.badge {
	display: inline-block;
	margin-right: 14px;
	padding: 2px 10px;
	font-size: 20px;
	font-weight: bold;
	color: #0d1322;
	background-color: #4dd6b8;
	border-radius: 6px;
}

/* ------------------------------------------------------------------ */
/* Video transport bar                                                */
/* ------------------------------------------------------------------ */

#watch-bar {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	padding: 36px 64px 44px 64px;
	background-color: #0a0e18e0;
	border-top: 2px #ffffff14;
}

.watch-row {
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 26px;
}

.watch-thumb {
	display: block;
	width: 148px;
	max-height: 84px;
	border-radius: 10px;
	margin-right: 28px;
}

.watch-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.watch-name {
	font-size: 40px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
	overflow: hidden;
}

/* Codec line: the video and audio streams being decoded, side by side. */
.watch-tracks {
	display: flex;
	flex-direction: row;
	margin-top: 6px;
	white-space: nowrap;
	overflow: hidden;
}

.watch-track {
	font-size: 24px;
	color: #8593ab;
	margin-right: 32px;
	white-space: nowrap;
}

.watch-side {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	margin-left: 40px;
}

.watch-clock {
	font-size: 40px;
	font-weight: bold;
	color: #e8edf7;
}

.watch-ends {
	margin-top: 4px;
	font-size: 22px;
	color: #8593ab;
	white-space: nowrap;
}

/* ------------------------------------------------------------------ */
/* Audio now-playing card                                             */
/* ------------------------------------------------------------------ */

#audio-card {
	position: absolute;
	left: 50%;
	top: 50%;
	box-sizing: border-box;
	margin-left: -500px;
	margin-top: -420px;
	width: 1000px;
	padding: 56px 64px;
	display: flex;
	flex-direction: column;
	align-items: center;
	background-color: #101827f2;
	border: 2px #ffffff14;
	border-radius: 22px;
	opacity: 0.7;
}

#audio-card .art {
	width: 200px;
	height: 200px;
	font-size: 110px;
	text-align: center;
	line-height: 200px;
	background-color: #4dd6b81a;
	border-radius: 20px;
	color: #4dd6b8;
	margin-bottom: 36px;
}

/* Downloaded artwork replaces the note glyph. */
#audio-card .np-art {
	display: block;
	width: 280px;
	max-height: 280px;
	border-radius: 20px;
	margin-bottom: 36px;
}

#audio-card .np-title {
	font-size: 42px;
	font-weight: bold;
	color: #e8edf7;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
	max-width: 860px;
}

#audio-card .np-meta {
	margin-top: 10px;
	font-size: 27px;
	color: #8593ab;
	text-align: center;
}

#audio-card .np-atrack {
	margin-top: 16px;
	font-size: 23px;
	color: #aab6cc;
	text-align: center;
}

#audio-card .timeline {
	margin-top: 40px;
}

#audio-card .tl-pos,
#audio-card .tl-dur {
	min-width: 80px;
	font-size: 24px;
}

#audio-card .np-sub {
	margin-top: 12px;
	height: 30px;
	font-size: 22px;
	color: #8593ab;
	text-align: center;
}

#audio-card .np-next {
	margin-top: 26px;
	padding-top: 22px;
	width: 100%;
	border-top: 1px #ffffff14;
	font-size: 24px;
	color: #aab6cc;
	text-align: center;
	white-space: nowrap;
	overflow: hidden;
}

#audio-card .np-next-label {
	margin-right: 16px;
	font-size: 18px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
}

/* ------------------------------------------------------------------ */
/* Loading the next track from inside watch mode                      */
/* ------------------------------------------------------------------ */

#launch-overlay {
	position: absolute;
	top: 48px;
	right: 56px;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 14px 26px;
	background-color: #0a0e18cc;
	border-radius: 10px;
}

#launch-overlay .launch-label {
	margin-left: 10px;
	font-size: 24px;
	color: #e8edf7;
}

/* ------------------------------------------------------------------ */
/* Screensaver                                                        */
/* ------------------------------------------------------------------ */

#saver {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #000000f8;
}

.saver-box {
	position: absolute;
	width: 760px;
}

.saver-clock {
	font-size: 150px;
	font-weight: bold;
	color: #5a6478;
}

.saver-date {
	font-size: 34px;
	color: #3c4454;
}

.saver-now {
	margin-top: 28px;
	font-size: 30px;
	color: #3c4454;
	white-space: nowrap;
	overflow: hidden;
}
