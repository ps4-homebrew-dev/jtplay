/*
 * Watch mode: hides the UI chrome so the video (drawn beneath the RmlUi
 * layer) shows through, with the OSD bar along the bottom. The bar's top
 * edge is the timeline: played in the accent, buffered ahead in a lighter
 * shade, a knob at the playhead, and a bubble with the target time while
 * seeking. For audio the bar stays up, with large cover art, over the
 * spectrum.
 */

/* Let the video drawn beneath the UI show through. */
body.watching {
	background-color: transparent;
	decorator: none;
}
body.watching #shell {
	display: none;
}

/* ------------------------------------------------------------------ */
/* OSD bar                                                            */
/* ------------------------------------------------------------------ */

#osd {
	z-index: 5;
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	box-sizing: border-box;
	padding: 38px 72px 44px 72px;
	background-color: #0a0e18f2;
	animation: 0.2s cubic-out osd-in;
}

@keyframes osd-in {
	from { transform: translateY(40px); opacity: 0; }
	to   { transform: translateY(0px); opacity: 1; }
}

/* The timeline, along the top edge. */
.osd-edge {
	position: absolute;
	left: 0px;
	right: 0px;
	top: 0px;
	height: 8px;
	background-color: #ffffff2e;
}

.osd-edge.live {
	background-color: #ff6b6b;
}

.osd-buffered,
.osd-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 8px;
}

.osd-buffered {
	background-color: #ffffff40;
}

.osd-played {
	decorator: linear-gradient(90deg, #2fa58c 0%, #4dd6b8 100%);
	box-shadow: #4dd6b880 0px 0px 14px 0px;
}

.osd-knob {
	position: absolute;
	top: -8px;
	width: 24px;
	height: 24px;
	margin-left: -12px;
	background-color: #ffffff;
	border: 5px #4dd6b8;
	border-radius: 12px;
	box-sizing: border-box;
}

/* Where a seek lands, over the knob's destination. */
.osd-seek {
	position: absolute;
	bottom: 24px;
	width: 200px;
	margin-left: -100px;
	padding: 8px 0px;
	font-size: 26px;
	font-weight: bold;
	text-align: center;
	color: #06231d;
	background-color: #4dd6b8;
	border-radius: 10px;
}

.osd-row {
	display: flex;
	flex-direction: row;
	align-items: center;
}

.osd-art {
	display: block;
	width: 176px;
	max-height: 100px;
	margin-right: 32px;
	border-radius: 10px;
}

.osd-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.osd-title {
	font-size: 40px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
}

.osd-state {
	margin-right: 12px;
	font-size: 32px;
	color: #4dd6b8;
}

.osd-desc {
	margin-top: 4px;
	font-size: 24px;
	color: #aab6cc;
	white-space: nowrap;
	overflow: hidden;
}

.osd-tracks {
	display: flex;
	flex-direction: row;
	margin-top: 8px;
	white-space: nowrap;
	overflow: hidden;
}

.osd-track {
	margin-right: 14px;
	padding: 3px 12px;
	font-size: 19px;
	color: #aab6cc;
	background-color: #ffffff12;
	border-radius: 6px;
	white-space: nowrap;
}

.osd-next {
	margin-top: 12px;
	font-size: 22px;
	color: #aab6cc;
	white-space: nowrap;
	overflow: hidden;
}

.osd-next-label {
	margin-right: 14px;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
}

.osd-side {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	margin-left: 48px;
}

.osd-time {
	white-space: nowrap;
}

.osd-pos {
	font-size: 46px;
	font-weight: bold;
	color: #ffffff;
}

.osd-dur {
	margin-left: 10px;
	font-size: 30px;
	color: #8593ab;
}

.osd-live {
	margin-left: 18px;
	padding: 3px 12px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #ffffff;
	background-color: #e04848;
	border-radius: 6px;
}

.osd-ends {
	margin-top: 6px;
	font-size: 22px;
	color: #8593ab;
	white-space: nowrap;
}

.badge {
	display: inline-block;
	margin-right: 14px;
	padding: 2px 10px;
	font-size: 20px;
	font-weight: bold;
	color: #06231d;
	background-color: #4dd6b8;
	border-radius: 6px;
}

/* Audio: a persistent now-playing panel with large cover art. */
#osd.audio {
	padding: 48px 72px 56px 72px;
	background-color: #0a0e18eb;
	animation: none;
}

#osd.audio .osd-art {
	width: 240px;
	max-height: 240px;
	margin-right: 44px;
	border-radius: 14px;
}

#osd.audio .osd-glyph {
	height: 240px;
	font-size: 120px;
	line-height: 240px;
	text-align: center;
	color: #a68bf0;
	background-color: #2d2147;
}

#osd.audio .osd-title {
	font-size: 48px;
}

/* ------------------------------------------------------------------ */
/* Clock, pause badge, launch indicator                               */
/* ------------------------------------------------------------------ */

#osd-clock {
	z-index: 5;
	position: absolute;
	top: 36px;
	right: 64px;
	font-size: 52px;
	font-weight: bold;
	color: #ffffff;
	font-effect: shadow(2px 2px #000000b0);
}

#pause-badge {
	z-index: 5;
	position: absolute;
	left: 50%;
	top: 50%;
	width: 180px;
	height: 180px;
	margin-left: -90px;
	margin-top: -90px;
	font-size: 84px;
	line-height: 180px;
	text-align: center;
	color: #ffffff;
	background-color: #0a0e18b0;
	border-radius: 90px;
	animation: 0.2s cubic-out pause-in;
}

@keyframes pause-in {
	from { transform: scale(0.7); opacity: 0; }
	to   { transform: scale(1); opacity: 1; }
}

#launch-overlay {
	z-index: 5;
	position: absolute;
	top: 48px;
	left: 64px;
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 8dp;
	padding: 14px 26px;
	background-color: #0a0e18cc;
	border-radius: 10px;
}

#launch-overlay .launch-label {
	margin-left: 10px;
	font-size: 24px;
	color: #e8edf7;
}

/* ------------------------------------------------------------------ */
/* Screensaver                                                        */
/* ------------------------------------------------------------------ */

#saver {
	z-index: 30;
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #000000f8;
}

.saver-box {
	position: absolute;
	width: 760px;
}

.saver-clock {
	font-size: 150px;
	font-weight: bold;
	color: #5a6478;
}

.saver-date {
	font-size: 34px;
	color: #3c4454;
}

.saver-now {
	margin-top: 28px;
	font-size: 30px;
	color: #3c4454;
	white-space: nowrap;
	overflow: hidden;
}
