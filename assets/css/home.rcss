/*
 * Home: tabs of places across the top (in the top bar), a banner showing
 * the card in focus large over its artwork, and rows of cards below.
 * Heights must stay in sync with kShelfPitch / kCardPitch in
 * src/app_internal.h.
 */

/* The page's margin is 72px, as everywhere; but what clips the rows
 * (.content, #home-main, #shelves) reaches 24px into it, so that a focused
 * card in the first column can grow to the left without losing its edge. */
#home.content {
	padding-left: 48px;
}
#home-main {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
	padding-left: 24px;
}

/* ------------------------------------------------------------------ */
/* Tabs                                                               */
/* ------------------------------------------------------------------ */

/* Always the five, at their full width; the first tab's icon on the page
 * margin, as the text below it is (its pill reaching out into the margin
 * when focused). */
#tabs {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-left: -26px;
	white-space: nowrap;
}

.tab {
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 60px;
	margin-right: 6px;
	padding: 0px 26px;
	border-radius: 30px;
	transition: background-color 0.12s linear-in-out;
}

.tab-icon {
	margin-right: 12px;
	font-size: 26px;
	color: #aab6cc;
}

.tab-label {
	font-size: 27px;
	font-weight: bold;
	color: #aab6cc;
}

/* Focused: the solid accent, as everywhere. */
.tab.selected {
	decorator: linear-gradient(90deg, #4dd6b8 0%, #38b89c 100%);
}
.tab.selected .tab-icon,
.tab.selected .tab-label { color: #06231d; }

/* Focus is down in the rows: the tab stays marked as where we are. */
#tabs.away .tab.selected {
	decorator: none;
	background-color: #ffffff1f;
}
#tabs.away .tab.selected .tab-icon,
#tabs.away .tab.selected .tab-label { color: #ffffff; }

/* ------------------------------------------------------------------ */
/* Banner                                                             */
/* ------------------------------------------------------------------ */

/* The card in focus, large; its artwork is the backdrop (layout.rcss).
 * As high as its fullest content (eyebrow, title, meta, progress, three
 * lines of description) and no more, so nothing is left empty under the
 * tabs; anchored to the bottom of that, so it sits on the rows whatever
 * it has to say, and the rows stay put as the focus moves. */
#feature {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	height: 340px;
	width: 1040px;
	padding-bottom: 30px;
}

.feat-eyebrow {
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #4dd6b8;
}

.feat-title {
	margin-top: 6px;
	font-size: 78px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	font-effect: shadow(0px 2px #00000066);
}

.feat-meta {
	margin-top: 4px;
	font-size: 27px;
	color: #e8edf7;
}

.feat-state {
	margin-right: 10px;
	font-size: 24px;
	color: #4dd6b8;
}
.feat-live {
	margin-left: 14px;
	padding: 2px 10px;
	font-size: 17px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #0b1020;
	background-color: #4dd6b8;
	border-radius: 4px;
}

.feat-progress {
	width: 420px;
	height: 6px;
	margin-top: 16px;
	background-color: #ffffff33;
	border-radius: 3px;
}
.feat-progress-bar {
	height: 6px;
	background-color: #4dd6b8;
	border-radius: 3px;
}

/* Three lines at most; the rest is for the browse view. */
.feat-desc {
	margin-top: 18px;
	max-height: 114px;
	font-size: 26px;
	line-height: 38px;
	color: #c5cee0;
	overflow: hidden;
}

/* A place with nothing else to show (an empty Home, a group with no
 * sources): its icon and what it says about itself, right under the tabs,
 * where the rows would begin. */
#hero {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 48px 0px;
}

.hero-icon {
	width: 112px;
	height: 112px;
	margin-right: 32px;
	font-size: 60px;
	line-height: 112px;
	text-align: center;
	color: #4dd6b8;
	background-color: #4dd6b81a;
	border-radius: 22px;
}

.hero-text {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.hero-title {
	font-size: 44px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.hero-detail {
	margin-top: 6px;
	font-size: 26px;
	color: #aab6cc;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.hero-note {
	margin-top: 18px;
	font-size: 24px;
	color: #8593ab;
}

/* On a group's page there is no banner: the tab says where we are, and
 * the grid of its sources starts right under it. The rows have that much
 * more room, and so does the space after the last (for it to get to the
 * top too, rather than leave the one above it cut). A group with no
 * sources says so where the grid would be. */
body.compact #feature {
	display: none;
}
body.compact #shelves {
	padding-top: 12px;
}
body.compact .shelves-end {
	height: 560px;
}

/* ------------------------------------------------------------------ */
/* Shelves and cards                                                  */
/* ------------------------------------------------------------------ */

#shelves {
	flex: 1;
	overflow-y: auto;
	margin-left: -24px;
	padding-left: 24px;
}

#shelves scrollbarvertical { width: 0px; }

.shelf-in {
	box-sizing: border-box;
	height: 380px;
	padding-top: 8px;
}

/* A group's sources: rows of four tiles, lower than rows of cards, so that
 * several show at once under the shorter banner (body.compact). */
.shelf-in.sources {
	height: auto;
	padding-bottom: 10px;
}
/* The first row after them: a gap between the grid and the next section. */
.shelf-in.gap {
	height: 404px;
	padding-top: 32px;
}

.source-tile {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 384px;
	height: 112px;
	padding: 0px 22px;
	background-color: #ffffff0f;
	border: 3px transparent;
	border-radius: 14px;
}

.source-icon {
	flex-shrink: 0;
	width: 64px;
	height: 64px;
	margin-right: 20px;
	font-size: 36px;
	line-height: 64px;
	text-align: center;
	color: #4dd6b8;
	background-color: #4dd6b81a;
	border-radius: 14px;
}

.source-text {
	display: flex;
	flex-direction: column;
	flex: 1;
	overflow: hidden;
}

.source-name {
	font-size: 25px;
	font-weight: bold;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.source-detail {
	margin-top: 4px;
	font-size: 19px;
	color: #6f7b92;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.card.selected .source-tile {
	background-color: #4dd6b81f;
	border: 3px #4dd6b8;
	box-shadow: #4dd6b855 0px 0px 24px 0px;
}
.card.selected .source-name { color: #ffffff; }
.card.selected .source-detail { color: #aab6cc; }

/* The rows scroll so that the focused one is at the top (src/app.cpp);
 * room after the last, so that it can get there too. */
.shelves-end {
	height: 240px;
}

.shelf-head {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	height: 44px;
	padding-left: 4px;
}

.shelf-title {
	font-size: 28px;
	font-weight: bold;
	color: #aab6cc;
}

#shelves.active .shelf.current .shelf-title {
	color: #ffffff;
}

.shelf-count {
	margin-left: 14px;
	font-size: 20px;
	color: #5a6478;
}

/* A group's search under way, or what went wrong with the last one. */
.shelf-status {
	flex: 1;
	margin-left: 24px;
	font-size: 20px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* The row of cards scrolls sideways under program control; the padding
 * leaves room for the focused card to grow without being clipped (it
 * grows 10px each way, its border and glow a little more), and the
 * negative margin keeps the cards where they were. */
.cards {
	display: flex;
	flex-direction: row;
	flex-wrap: nowrap;
	margin-left: -18px;
	padding: 14px 20px 0px 24px;
	overflow-x: auto;
	overflow-y: hidden;
	white-space: nowrap;
}

.cards scrollbarhorizontal { height: 0px; }

.card {
	flex-shrink: 0;
	width: 384px;
	margin-right: 24px;
	transform: scale(1);
	transition: transform 0.15s cubic-out;
}

.card .art-tile {
	width: 384px;
	height: 216px;
	border: 3px transparent;
}

.card .art-glyph {
	font-size: 84px;
}

.card-title {
	margin-top: 12px;
	font-size: 25px;
	font-weight: bold;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.card-sub {
	margin-top: 2px;
	font-size: 19px;
	color: #6f7b92;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Focused card: lifted, outlined in the accent. */
.card.selected {
	transform: scale(1.05);
}
.card.selected .art-tile {
	border: 3px #4dd6b8;
	box-shadow: #4dd6b855 0px 0px 24px 0px;
}
.card.selected .card-title { color: #ffffff; }
.card.selected .card-sub { color: #aab6cc; }

/* ------------------------------------------------------------------ */
/* Settings                                                           */
/* ------------------------------------------------------------------ */

/* The page under the Settings tab: a column of settings, not stretched
 * across the screen (a label at one edge and its value at the other are
 * hard to pair from the couch), and beside it what the focused one does. */
#settings {
	display: flex;
	flex-direction: row;
	flex: 1;
	overflow: hidden;
	padding-top: 12px;
}

#settings-list {
	flex: 0 0 auto;
	width: 920px;
	margin-left: -24px;
	padding-left: 24px;
	overflow-y: auto;
}
#settings-list scrollbarvertical { width: 0px; }

/* Room after the last row, for it to scroll into view above the floor. */
.settings-end {
	height: 48px;
}

.setting-section {
	margin: 28px 0px 12px 4px;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	text-transform: uppercase;
	color: #5a6478;
}
.setting-item:first-child .setting-section {
	margin-top: 0px;
}
#settings.active .setting-section {
	color: #8593ab;
}

.setting-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin: 0px 0px 6px -24px;
	padding: 0px 24px;
	border-radius: 10px;
	background-color: #ffffff08;
}

.setting-label {
	flex: 1;
	font-size: 28px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.setting-value,
.setting-count {
	max-width: 360px;
	font-size: 25px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Focused: the solid accent, as everywhere. */
.setting-row.selected {
	decorator: linear-gradient(90deg, #4dd6b8 0%, #38b89c 100%);
}
.setting-row.selected .setting-label { color: #06231d; font-weight: bold; }
.setting-row.selected .setting-value,
.setting-row.selected .setting-count { color: #0d3d33; }

/* What the focused setting does, in the room to the right. */
#setting-about {
	flex: 0 1 640px;
	margin-left: 72px;
	padding: 40px 0px 0px 40px;
	border-left: 2px #ffffff14;
}

.about-title {
	font-size: 34px;
	font-weight: bold;
	color: #ffffff;
}

.about-text {
	margin-top: 16px;
	font-size: 26px;
	line-height: 38px;
	color: #aab6cc;
}
