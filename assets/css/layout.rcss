/*
 * Screen scaffold: the fanart backdrop, topbar, content area, the generic
 * pane/list chrome, and notifications. There is no footer: everything is
 * driven by the remote, and the options button opens a menu (menu.rcss)
 * for whatever is not on the d-pad.
 *
 * Focus is a solid accent bar with dark text everywhere (rail, rows,
 * tiles, menus), as in Kodi: the one bright thing on screen is where you
 * are.
 */

/* Above the backdrop layers, which are positioned. */
#shell {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.spacer {
	display: block;
	flex: 1;
}

/* ------------------------------------------------------------------ */
/* Backdrop                                                           */
/* ------------------------------------------------------------------ */

#backdrop {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	opacity: 0.32;
}

/* Darkens the left, where the lists are, and lets the art show on the
 * right; plus a floor so the bottom of the screen never glares. */
#backdrop-shade {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	decorator: linear-gradient(90deg, #0b1020f2 0%, #0b1020cc 45%, #0b102066 100%),
	           linear-gradient(180deg, #0b102000 55%, #0b1020e6 100%);
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 124px;
	padding: 0px 72px;
}

#topbar img.brand-logo {
	display: inline-block;
	width: 64px;
	height: 64px;
	margin-right: 24px;
}

#topbar .location {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	flex: 1;
	overflow: hidden;
	white-space: nowrap;
}

#topbar .wordmark {
	font-size: 36px;
	font-weight: bold;
	letter-spacing: 2px;
	color: #e8edf7;
}

#topbar .location-source {
	font-size: 34px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
}

#topbar .location-path {
	margin-left: 18px;
	font-size: 26px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
}

#topbar .busy {
	display: flex;
	gap: 6dp;
	margin: 0px 36px;
}

#topbar .clockbox {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
}

#topbar .clock {
	font-size: 46px;
	font-weight: bold;
	color: #e8edf7;
}

#topbar .date {
	font-size: 20px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Content                                                            */
/* ------------------------------------------------------------------ */

.content {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	flex: 1;
	padding: 0px 72px 48px 72px;
	overflow: hidden;
}

.pane {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.pane-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 44px;
	margin-bottom: 8px;
	padding: 0px 8px;
}

.eyebrow {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
	white-space: nowrap;
	overflow: hidden;
}

.pane-head .sort {
	display: inline-block;
	margin-right: 28px;
	font-size: 20px;
	color: #8593ab;
	white-space: nowrap;
}

.pane-head .position {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	color: #8593ab;
	white-space: nowrap;
}

.list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}

.list scrollbarvertical {
	width: 6px;
}

.list scrollbarvertical slidertrack {
	background-color: #ffffff05;
}

.list scrollbarvertical sliderbar {
	background-color: #ffffff2a;
	border-radius: 3px;
}

.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

.empty {
	margin-top: 64px;
	font-size: 28px;
	color: #5a6478;
	text-align: center;
}

/* ------------------------------------------------------------------ */
/* Artwork tiles (home cards, grid tiles, list thumbnails)            */
/* ------------------------------------------------------------------ */

/* The box art goes in: the image cover-fitted, or the type's glyph on a
 * tint of its own, so a wall of local files without art still reads at a
 * glance (folders slate, video teal, audio violet, images blue). */
.art-tile {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	overflow: hidden;
	background-color: #1a2234;
	border-radius: 10px;
}

.art-tile.k-folder { background-color: #252e40; }
.art-tile.k-video  { background-color: #163633; }
.art-tile.k-audio  { background-color: #2d2147; }
.art-tile.k-image  { background-color: #1a2c47; }

.art-img {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
}

.art-glyph {
	color: #ffffff;
	opacity: 0.55;
}
.k-folder .art-glyph { color: #9fb0cc; opacity: 0.9; }
.k-video .art-glyph  { color: #4dd6b8; opacity: 0.9; }
.k-audio .art-glyph  { color: #a68bf0; opacity: 0.9; }
.k-image .art-glyph  { color: #6fa8ff; opacity: 0.9; }

/* Watched tick and favorite star in the corner of the art. */
.art-check,
.art-fav {
	position: absolute;
	top: 8px;
	right: 10px;
	padding: 2px 8px;
	font-size: 20px;
	color: #4dd6b8;
	background-color: #0b1020cc;
	border-radius: 12px;
}

.art-fav {
	right: auto;
	left: 10px;
	color: #e0b84d;
}

/* How far an unfinished item got, along the bottom edge of the art. */
.art-prog {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 6px;
	background-color: #00000099;
}

.art-prog-bar {
	height: 6px;
	background-color: #4dd6b8;
}

/* ------------------------------------------------------------------ */
/* Notifications                                                      */
/* ------------------------------------------------------------------ */

#toast {
	z-index: 20;
	position: absolute;
	top: 132px; /* under the clock, in every view */
	right: 56px;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	max-width: 760px;
	padding: 18px 28px 18px 20px;
	background-color: #151d2ff2;
	border-left: 6px #4dd6b8;
	border-radius: 12px;
	box-shadow: #00000080 0px 10px 30px 0px;
	animation: 0.25s cubic-out toast-in;
}

@keyframes toast-in {
	from { opacity: 0; transform: translateX(40px); }
	to   { opacity: 1; transform: translateX(0px); }
}

.toast-icon {
	width: 44px;
	font-size: 28px;
	color: #4dd6b8;
	text-align: center;
	margin-right: 14px;
}

.toast-text {
	font-size: 26px;
	color: #e8edf7;
}
