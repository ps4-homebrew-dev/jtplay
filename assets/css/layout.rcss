/*
 * Screen scaffold: the fanart backdrop, topbar, content area, the generic
 * pane/list chrome, and notifications. There is no footer: everything is
 * driven by the remote, and the options button opens a menu (menu.rcss)
 * for whatever is not on the d-pad.
 *
 * Focus is a solid accent bar with dark text everywhere (tabs, rows,
 * tiles, menus), as in Kodi: the one bright thing on screen is where you
 * are.
 */

/* Above the backdrop layers, which are positioned. */
#shell {
	position: relative;
	z-index: 1;
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.spacer {
	display: block;
	flex: 1;
}

/* ------------------------------------------------------------------ */
/* Backdrop                                                           */
/* ------------------------------------------------------------------ */

#backdrop {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	opacity: 0.45;
}

/* Darkens the left, where the lists are, and lets the art show on the
 * right; plus a floor so the bottom of the screen never glares. */
#backdrop-shade {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	decorator: linear-gradient(90deg, #0b1020f2 0%, #0b1020cc 45%, #0b102066 100%),
	           linear-gradient(180deg, #0b102000 55%, #0b1020e6 100%);
}

/* Home, with a card to feature: its artwork is the banner's picture, at
 * full strength across the top of the screen, darkened only where the
 * text and the tabs sit, and fading into the background above the rows. */
body.home.featured #backdrop {
	opacity: 1;
	bottom: 410px;
}
/* The fade down is solid by 62%: 670 of 1080px, where the artwork ends
 * (bottom: 410px). Any later and its bottom edge shows as a line. */
body.home.featured #backdrop-shade {
	decorator: linear-gradient(90deg, #0b1020 0%, #0b1020e6 24%, #0b102080 50%, #0b102000 76%),
	           linear-gradient(180deg, #0b1020c0 0%, #0b102000 20%, #0b102000 40%, #0b1020 62%);
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 124px;
	padding: 0px 72px;
}

#topbar .location {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	flex: 1;
	overflow: hidden;
	white-space: nowrap;
}

#topbar .location-source {
	font-size: 34px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
}

#topbar .location-path {
	margin-left: 18px;
	font-size: 26px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* What plays behind the menus: a pill by the clock, with the time and a
 * hairline of progress along its bottom. It is what gives way when the
 * top bar is short of room: the title is cut short, never the tabs. */
#np-chip {
	position: relative;
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 auto;
	min-width: 140px;
	max-width: 520px;
	height: 52px;
	margin-left: 24px;
	padding: 0px 22px 0px 18px;
	background-color: #ffffff14;
	border-radius: 26px;
	overflow: hidden;
	white-space: nowrap;
	animation: 0.25s cubic-out np-chip-in;
}
@keyframes np-chip-in {
	from { opacity: 0; }
	to   { opacity: 1; }
}
.np-chip-state {
	flex-shrink: 0;
	margin-right: 12px;
	font-size: 22px;
	color: #4dd6b8;
}
.np-chip-title {
	flex: 0 1 auto;
	min-width: 0px;
	max-width: 380px;
	font-size: 23px;
	font-weight: bold;
	color: #e8edf7;
	overflow: hidden;
	text-overflow: ellipsis;
}
.np-chip-time {
	flex-shrink: 0;
	margin-left: 14px;
	font-size: 21px;
	color: #8593ab;
}
.np-chip-bar {
	position: absolute;
	left: 22px;
	right: 22px;
	bottom: 6px;
	height: 3px;
	background-color: #ffffff1f;
	border-radius: 2px;
}
.np-chip-played {
	height: 3px;
	background-color: #4dd6b8;
	border-radius: 2px;
}

#topbar .busy {
	display: flex;
	flex-shrink: 0;
	gap: 6dp;
	margin: 0px 36px;
}

#topbar .clockbox {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
	flex-shrink: 0;
	white-space: nowrap;
}

#topbar .clock {
	font-size: 46px;
	font-weight: bold;
	color: #e8edf7;
}

#topbar .date {
	font-size: 20px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Content                                                            */
/* ------------------------------------------------------------------ */

.content {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	flex: 1;
	padding: 0px 72px 48px 72px;
	overflow: hidden;
}

.pane {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.pane-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 44px;
	margin-bottom: 8px;
	padding: 0px 8px;
}

.eyebrow {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
	white-space: nowrap;
	overflow: hidden;
}

.pane-head .sort {
	display: inline-block;
	margin-right: 28px;
	font-size: 20px;
	color: #8593ab;
	white-space: nowrap;
}

.pane-head .position {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	color: #8593ab;
	white-space: nowrap;
}

.list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}

.list scrollbarvertical {
	width: 6px;
}

.list scrollbarvertical slidertrack {
	background-color: #ffffff05;
}

.list scrollbarvertical sliderbar {
	background-color: #ffffff2a;
	border-radius: 3px;
}

.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

.empty {
	margin-top: 64px;
	font-size: 28px;
	color: #5a6478;
	text-align: center;
}

/* ------------------------------------------------------------------ */
/* Artwork tiles (home cards, grid tiles, list thumbnails)            */
/* ------------------------------------------------------------------ */

/* The box art goes in: the image cover-fitted, or the type's glyph on a
 * tint of its own, so a wall of local files without art still reads at a
 * glance (folders slate, video teal, audio violet, images blue). */
.art-tile {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	overflow: hidden;
	background-color: #1a2234;
	border-radius: 10px;
}

.art-tile.k-folder { background-color: #252e40; }
.art-tile.k-video  { background-color: #163633; }
.art-tile.k-audio  { background-color: #2d2147; }
.art-tile.k-image  { background-color: #1a2c47; }

.art-img {
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
}

.art-glyph {
	font-weight: bold;
	color: #ffffff;
	opacity: 0.55;
}
.k-folder .art-glyph { color: #9fb0cc; opacity: 0.9; }
.k-video .art-glyph  { color: #4dd6b8; opacity: 0.9; }
.k-audio .art-glyph  { color: #a68bf0; opacity: 0.9; }
.k-image .art-glyph  { color: #6fa8ff; opacity: 0.9; }

/* Watched tick and favorite star in the corner of the art. */
.art-check,
.art-fav {
	position: absolute;
	top: 8px;
	right: 10px;
	padding: 2px 8px;
	font-size: 20px;
	color: #4dd6b8;
	background-color: #0b1020cc;
	border-radius: 12px;
}

.art-fav {
	right: auto;
	left: 10px;
	color: #e0b84d;
}

/* The card of what plays: says so, in the corner. */
.art-live {
	position: absolute;
	top: 12px;
	left: 12px;
	padding: 4px 12px;
	font-size: 19px;
	font-weight: bold;
	letter-spacing: 1px;
	color: #0b1020;
	background-color: #4dd6b8;
	border-radius: 14px;
}

/* How far an unfinished item got, along the bottom edge of the art. */
.art-prog {
	position: absolute;
	left: 0px;
	right: 0px;
	bottom: 0px;
	height: 6px;
	background-color: #00000099;
}

.art-prog-bar {
	height: 6px;
	background-color: #4dd6b8;
}

/* ------------------------------------------------------------------ */
/* Notifications                                                      */
/* ------------------------------------------------------------------ */

#toast {
	z-index: 20;
	position: absolute;
	top: 132px; /* under the clock, in every view */
	right: 56px;
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	max-width: 760px;
	padding: 18px 28px 18px 26px;
	background-color: #151d2ff2;
	/* The accent as an inset shadow: a border on one side of a rounded box
	   tapers along its corners into a ragged tip. */
	border-radius: 12px;
	box-shadow: #4dd6b8 6px 0px 0px 0px inset, #00000080 0px 10px 30px 0px;
	animation: 0.25s cubic-out toast-in;
}

@keyframes toast-in {
	from { opacity: 0; transform: translateX(40px); }
	to   { opacity: 1; transform: translateX(0px); }
}

.toast-icon {
	width: 44px;
	font-size: 28px;
	color: #4dd6b8;
	text-align: center;
	margin-right: 14px;
}

.toast-text {
	font-size: 26px;
	color: #e8edf7;
}
