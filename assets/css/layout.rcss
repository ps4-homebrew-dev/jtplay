/*
 * Screen scaffold: topbar, content columns, and the generic pane/list
 * chrome each view sits in. There is no footer: everything is driven by
 * the remote, and the options button opens a menu (menu.rcss) for the
 * less common actions.
 */

#shell {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.spacer {
	display: block;
	flex: 1;
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 128px;
	padding: 0px 72px;
}

#topbar img.brand-logo {
	display: inline-block;
	width: 72px;
	height: 72px;
	margin-right: 28px;
}

#topbar .location {
	display: flex;
	flex-direction: row;
	align-items: baseline;
	flex: 1;
	overflow: hidden;
	white-space: nowrap;
}

#topbar .location-source {
	font-size: 34px;
	font-weight: bold;
	color: #e8edf7;
	white-space: nowrap;
}

#topbar .location-path {
	margin-left: 18px;
	font-size: 26px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
}

#topbar .busy {
	display: flex;
	gap: 6dp;
	margin: 0px 36px;
}

#topbar .clockbox {
	display: flex;
	flex-direction: column;
	align-items: flex-end;
}

#topbar .clock {
	font-size: 44px;
	font-weight: bold;
	color: #e8edf7;
}

#topbar .date {
	font-size: 20px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Content                                                            */
/* ------------------------------------------------------------------ */

.content {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	flex: 1;
	padding: 0px 72px 56px 72px;
	overflow: hidden;
}

/* ------------------------------------------------------------------ */
/* Panes and lists                                                    */
/* ------------------------------------------------------------------ */

.pane {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.pane-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 48px;
	margin-bottom: 8px;
	padding: 0px 8px;
}

.eyebrow {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 3px;
	color: #4dd6b8;
	white-space: nowrap;
	overflow: hidden;
}

.pane-head .sort {
	display: inline-block;
	margin-right: 28px;
	font-size: 20px;
	color: #8593ab;
	white-space: nowrap;
}

.pane-head .position {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	color: #8593ab;
	white-space: nowrap;
}

.list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}

.list scrollbarvertical {
	width: 6px;
}

.list scrollbarvertical slidertrack {
	background-color: #ffffff05;
}

.list scrollbarvertical sliderbar {
	background-color: #ffffff2a;
	border-radius: 3px;
}

.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

.empty {
	margin-top: 64px;
	font-size: 28px;
	color: #5a6478;
	text-align: center;
}

.status {
	margin-top: 14px;
	padding: 0px 8px;
	font-size: 22px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Toast                                                              */
/* ------------------------------------------------------------------ */

#toast {
	position: absolute;
	left: 50%;
	bottom: 96px;
	margin-left: -420px;
	box-sizing: border-box;
	width: 840px;
	padding: 20px 28px;
	font-size: 26px;
	text-align: center;
	color: #e8edf7;
	background-color: #1a2336f0;
	border: 2px #4dd6b866;
	border-radius: 14px;
}
