/*
 * Screen scaffold: topbar, content columns, footer, and the generic
 * pane/list chrome each view sits in.
 */

#shell {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

/* ------------------------------------------------------------------ */
/* Top bar                                                            */
/* ------------------------------------------------------------------ */

#topbar {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 104px;
	padding: 0px 64px;
}

#topbar img.brand-logo {
	display: inline-block;
	width: 72px;
	height: 72px;
}

#topbar .brand-label {
	display: inline-block;
	font-size: 22px;
	font-weight: bold;
	letter-spacing: 6px;
	color: #4dd6b8;
}

#topbar .crumb {
	display: inline-block;
	margin-left: 32px;
	font-size: 24px;
	color: #8593ab;
	white-space: nowrap;
	overflow: hidden;
	max-width: 1000px;
}

#topbar .spacer {
	display: block;
	flex: 1;
}

#topbar .busy {
	display: flex;
	gap: 6dp;
}

#topbar .player-status {
	display: inline-block;
	margin-right: 28px;
	font-size: 22px;
	color: #8593ab;
}

#topbar .clock {
	display: inline-block;
	font-size: 42px;
	font-weight: bold;
	color: #e8edf7;
}

/* ------------------------------------------------------------------ */
/* Content + footer                                                   */
/* ------------------------------------------------------------------ */

#content {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	flex: 1;
	padding: 0px 64px;
	overflow: hidden;
}

#footer {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 92px;
	padding: 0px 64px;
}

.chip {
	box-sizing: border-box;
	display: inline-block;
	padding: 7px 15px;
	margin-right: 20px;
	font-size: 19px;
	font-weight: bold;
	letter-spacing: 1px;
	color: #8593ab;
	background-color: #ffffff0d;
	border: 1px #ffffff1f;
	border-radius: 8px;
}

/* ------------------------------------------------------------------ */
/* Panes and lists                                                    */
/* ------------------------------------------------------------------ */

.pane {
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.pane-head {
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 52px;
	margin-bottom: 10px;
}

.eyebrow {
	display: inline-block;
	font-size: 20px;
	font-weight: bold;
	letter-spacing: 4px;
	color: #5a6478;
	white-space: nowrap;
	overflow: hidden;
}

.pane.active .eyebrow {
	color: #4dd6b8;
}

.pane-head .count {
	display: inline-block;
	margin-left: 16px;
	font-size: 20px;
	color: #5a6478;
	white-space: nowrap;
	overflow: hidden;
}

.list {
	flex: 1;
	overflow-x: hidden;
	overflow-y: auto;
}

.list scrollbarvertical {
	width: 8px;
}

.list scrollbarvertical slidertrack {
	background-color: #ffffff05;
}

.list scrollbarvertical sliderbar {
	background-color: #ffffff22;
	border-radius: 4px;
}

.list scrollbarvertical sliderarrowdec,
.list scrollbarvertical sliderarrowinc {
	width: 0px;
	height: 0px;
}

.empty {
	margin-top: 48px;
	font-size: 26px;
	color: #5a6478;
	text-align: center;
}

.status {
	margin-top: 14px;
	margin-bottom: 10px;
	font-size: 22px;
	color: #8593ab;
}

/* ------------------------------------------------------------------ */
/* Toast                                                              */
/* ------------------------------------------------------------------ */

#toast {
	position: absolute;
	left: 50%;
	bottom: 120px;
	margin-left: -420px;
	width: 840px;
	padding: 20px 28px;
	font-size: 26px;
	text-align: center;
	color: #e8edf7;
	background-color: #1a2336f0;
	border: 2px #4dd6b866;
	border-radius: 14px;
}

/* PlayStation button hint icons (assets/icons; see scripts/fetch-icons.sh).
 * Rendered at 96px, displayed at 34px so they stay crisp. */
.key-icon {
	display: inline-block;
	width: 34px;
	height: 34px;
	vertical-align: -7px;
	margin-right: 6px;
}
