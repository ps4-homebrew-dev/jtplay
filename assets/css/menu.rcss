/*
 * Options menu: a side blade over the left edge, opened with the options
 * button; or (#menu.dialog) a small dialog in the middle of the screen for
 * a question that needs an answer before anything else (resume?). Left /
 * right change a setting in place, select runs an action, back closes.
 */

/* Stacking, bottom to top: backdrop 0, shell 1, OSD 5, menu 10,
 * notifications 20, screensaver 30. */
#menu-scrim {
	z-index: 9;
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #05080fb8;
}

#menu {
	z-index: 10;
	position: absolute;
	left: 0px;
	top: 0px;
	bottom: 0px;
	box-sizing: border-box;
	width: 640px;
	padding: 72px 40px;
	display: flex;
	flex-direction: column;
	decorator: linear-gradient(90deg, #141c2e 0%, #10172a 100%);
	border-right: 2px #ffffff14;
	box-shadow: #000000a0 20px 0px 60px 0px;
	animation: 0.18s cubic-out blade-in;
}

@keyframes blade-in {
	from { transform: translateX(-80px); opacity: 0; }
	to   { transform: translateX(0px); opacity: 1; }
}

.menu-title {
	margin: 0px 0px 36px 24px;
	font-size: 30px;
	font-weight: bold;
	color: #ffffff;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Long menus (the playback menu) scroll; the app keeps the selection in
 * view. */
#menu-rows {
	flex: 1;
	overflow-y: hidden;
}
#menu.dialog #menu-rows {
	flex: none;
}

.menu-row {
	box-sizing: border-box;
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 72px;
	margin-bottom: 6px;
	padding: 0px 24px;
	border-radius: 10px;
}

.menu-label {
	flex: 1;
	font-size: 28px;
	color: #c5cee0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.menu-value {
	font-size: 24px;
	color: #8593ab;
	white-space: nowrap;
}

.menu-row.selected {
	decorator: linear-gradient(90deg, #4dd6b8 0%, #38b89c 100%);
}
.menu-row.selected .menu-label { color: #06231d; font-weight: bold; }
.menu-row.selected .menu-value { color: #0d3d33; }

/* ------------------------------------------------------------------ */
/* Dialog                                                             */
/* ------------------------------------------------------------------ */

/* In the now-playing card's style: glass over what it interrupts, one
 * border all around. (A border on one side of a rounded box tapers along
 * its corners into a ragged sliver.) */
#menu.dialog {
	left: 50%;
	top: 50%;
	bottom: auto;
	width: 760px;
	margin-left: -380px;
	margin-top: -210px;
	padding: 40px 48px 32px 48px;
	border-right-width: 0px;
	border: 1px #ffffff1f;
	border-radius: 24px;
	decorator: none;
	background-color: #10172acc;
	backdrop-filter: blur(28px);
	box-shadow: #000000a0 0px 24px 70px 0px;
	animation: 0.2s cubic-out dialog-in;
}

@keyframes dialog-in {
	from { transform: scale(0.94); opacity: 0; }
	to   { transform: scale(1); opacity: 1; }
}

#menu.dialog .menu-title {
	margin: 0px 0px 28px 0px;
	font-size: 34px;
	text-align: center;
}

#menu.dialog .menu-row {
	justify-content: center;
	border-radius: 14px;
}

/* Resume: where it was left, as text and as a bar like the player's. */
.dialog-meta {
	margin: -18px 0px 0px 0px;
	font-size: 22px;
	color: #8593ab;
	text-align: center;
}

.dialog-progress {
	position: relative;
	height: 6px;
	margin: 22px 0px 30px 0px;
	background-color: #ffffff1f;
	border-radius: 3px;
}

.dialog-played {
	position: absolute;
	left: 0px;
	top: 0px;
	height: 6px;
	background-color: #4dd6b8;
	border-radius: 3px;
}

#menu.dialog .menu-label {
	flex: none;
}

/* The value is what changes with left / right: keep it visible. */
.menu-value {
	max-width: 300px;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* ------------------------------------------------------------------ */
/* Search                                                             */
/* ------------------------------------------------------------------ */

/* A dialog like #menu.dialog, with a text field in place of the rows. The
 * app focuses the field, which is what brings up the system keyboard on a
 * console; on a PC it is typed into. Return searches, Escape closes. */
#search-scrim {
	z-index: 9;
	position: absolute;
	left: 0px;
	top: 0px;
	right: 0px;
	bottom: 0px;
	background-color: #05080fb8;
}

#search {
	z-index: 10;
	position: absolute;
	left: 50%;
	top: 50%;
	width: 900px;
	margin-left: -450px;
	margin-top: -130px;
	box-sizing: border-box;
	padding: 44px 48px 48px 48px;
	border: 1px #ffffff1f;
	border-radius: 24px;
	background-color: #10172acc;
	backdrop-filter: blur(28px);
	box-shadow: #000000a0 0px 24px 70px 0px;
	animation: 0.2s cubic-out dialog-in;
}

#search .menu-title {
	margin: 0px 0px 28px 0px;
	font-size: 34px;
	text-align: center;
}

#search-input {
	display: block;
	box-sizing: border-box;
	width: 100%;
	height: 84px;
	padding: 20px 28px 0px 28px;
	font-size: 34px;
	color: #ffffff;
	background-color: #0b1020;
	border: 2px #4dd6b8;
	border-radius: 12px;
	overflow: hidden;
	caret-color: #4dd6b8;
}

#search-input::selection {
	color: #06231d;
	background-color: #4dd6b8;
}
