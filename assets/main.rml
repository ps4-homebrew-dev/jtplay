<rml>
	<head>
		<title>JTPlay</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="theme.rcss"/>
		<link type="text/rcss" href="css/layout.rcss"/>
		<link type="text/rcss" href="css/browse.rcss"/>
		<link type="text/rcss" href="css/menu.rcss"/>
		<link type="text/rcss" href="css/watch.rcss"/>
		<link type="text/rcss" href="css/busy.rcss"/>
	</head>
	<body data-model="jtplay" data-class-watching="watching">

		<div id="shell">
			<div id="topbar">
				<img class="brand-logo" src="icons/logo.png"/>
				<div class="location">
					<span class="location-source" data-if="view == 'browse'">{{source_name}}</span>
					<span class="location-source" data-if="view == 'sources'">Media sources</span>
					<span class="location-path" data-if="view == 'browse' && crumb != ''">›  {{crumb}}</span>
				</div>
				<span class="busy">
					<span class="busy-dot busy-dot0"/>
					<span class="busy-dot busy-dot1" data-if="busy"/>
					<span class="busy-dot busy-dot2" data-if="busy"/>
					<span class="busy-dot busy-dot3" data-if="busy"/>
				</span>
				<div class="clockbox">
					<div class="clock">{{clock}}</div>
					<div class="date">{{date}}</div>
				</div>
			</div>

			<!-- ========================== Sources ========================== -->
			<div id="content-sources" class="content" data-if="view == 'sources'">
				<div id="sources" class="pane">
					<div class="pane-head">
						<span class="eyebrow">Sources</span>
						<span class="spacer"/>
						<span class="position" data-if="source_count > 0">{{sel_source + 1}} / {{source_count}}</span>
					</div>
					<div id="source-list" class="list">
						<div class="source-row" data-for="src : sources"
						     data-class-selected="it_index == sel_source">
							<div class="srcicon">{{src.icon}}</div>
							<div class="srcinfo">
								<div class="srcname">{{src.name}}</div>
								<div class="srcdetail">{{src.detail}}</div>
							</div>
						</div>
						<div class="empty" data-if="source_count == 0 && !busy">
							No media sources found.
						</div>
						<div class="empty" data-if="source_count == 0 && busy">
							Searching for media sources...
						</div>
					</div>
					<div class="status" data-if="status != ''">{{status}}</div>
				</div>
			</div>

			<!-- =========================== Browse ========================== -->
			<div id="content-browse" class="content" data-if="view == 'browse'">
				<div id="entries" class="pane">
					<div class="pane-head">
						<span class="eyebrow">{{entry_count}} items</span>
						<span class="spacer"/>
						<span class="sort">{{sort_label}}</span>
						<span class="position" data-if="entry_count > 0">{{sel_entry + 1}} / {{entry_count}}</span>
					</div>
					<div id="entry-list" class="list">
						<div class="entry-row" data-for="e : entries"
						     data-class-selected="it_index == sel_entry"
						     data-class-folder="e.folder">
							<div class="eicon">{{e.icon}}</div>
							<div class="etitle">{{e.name}}</div>
							<span class="emark" data-if="e.favorite">⭐</span>
							<span class="emark watched" data-if="e.watched">✔</span>
							<div class="emeta" data-if="e.meta != ''">{{e.meta}}</div>
							<div class="eprog" data-if="e.progress != '0%'">
								<div class="eprog-bar" data-style-width="e.progress"/>
							</div>
						</div>
						<div class="empty" data-if="entry_count == 0 && !busy">
							This folder is empty.
						</div>
						<div class="empty" data-if="entry_count == 0 && busy">
							Loading...
						</div>
					</div>
				</div>

				<div id="details" class="pane">
					<div class="detail-body" data-if="detail_name != ''">
						<div class="detail-artbox">
							<img class="detail-art" data-if="detail_image != ''" data-attr-src="detail_image"/>
							<div class="detail-glyph" data-if="detail_image == ''">{{detail_icon}}</div>
						</div>
						<div class="detail-title"><span class="detail-fav" data-if="detail_favorite">⭐ </span>{{detail_name}}</div>
						<div class="detail-props">
							<div class="prop" data-for="p : detail_props">
								<span class="prop-label">{{p.label}}</span>
								<span class="prop-value">{{p.value}}</span>
							</div>
						</div>
						<div class="detail-desc" data-if="detail_description != ''">{{detail_description}}</div>
					</div>
				</div>
			</div>
		</div>

		<!-- ========================= Options menu ======================== -->
		<div id="menu-scrim" data-if="menu_open"/>
		<div id="menu" data-if="menu_open">
			<div class="menu-title">{{menu_title}}</div>
			<div class="menu-row" data-for="m : menu"
			     data-class-selected="it_index == sel_menu">
				<span class="menu-label">{{m.label}}</span>
				<span class="menu-value" data-if="m.value != ''">‹  {{m.value}}  ›</span>
			</div>
		</div>

		<!-- =========================== Watching ========================== -->

		<!-- Audio: persistent now-playing card in the middle of the screen. -->
		<div id="audio-card" data-if="watching && watch_audio">
			<img class="np-art" data-if="watch_image != ''" data-attr-src="watch_image"/>
			<div class="art" data-if="watch_image == ''">🎵</div>
			<div class="np-title">{{watch_name}}</div>
			<div class="np-meta" data-if="watch_description != ''">{{watch_description}}</div>
			<div class="np-atrack" data-if="watch_atrack != ''">{{watch_atrack}}</div>
			<div class="timeline">
				<span class="tl-state" data-if="watch_paused">⏸</span>
				<span class="tl-state" data-if="!watch_paused">▶</span>
				<span class="tl-pos">{{watch_pos}}</span>
				<div class="tl-track" data-if="watch_seekable">
					<div class="tl-buffered" data-style-width="watch_buffered"/>
					<div class="tl-played" data-style-width="watch_progress"/>
				</div>
				<span class="tl-live" data-if="!watch_seekable">LIVE</span>
				<span class="tl-dur" data-if="watch_dur != ''">{{watch_dur}}</span>
			</div>
			<div class="np-sub">
				<span data-if="watch_speed != ''" class="badge">{{watch_speed}}</span>
				<span class="np-ends" data-if="watch_ends != ''">{{watch_ends}}</span>
			</div>
			<div class="np-next" data-if="watch_next != ''">
				<span class="np-next-label">Up next</span>{{watch_next}}
			</div>
		</div>

		<!-- Video: auto-hiding transport bar over the frames. The timeline
		     spans the full width of the bar, Kodi style. -->
		<div id="watch-bar" data-if="watching && !watch_audio && info_visible">
			<div class="watch-row">
				<img class="watch-thumb" data-if="watch_image != ''" data-attr-src="watch_image"/>
				<div class="watch-main">
					<div class="watch-name">{{watch_name}}</div>
					<div class="watch-tracks">
						<span class="watch-track" data-if="watch_vtrack != ''">Video  {{watch_vtrack}}</span>
						<span class="watch-track" data-if="watch_atrack != ''">Audio  {{watch_atrack}}</span>
					</div>
				</div>
				<div class="watch-side">
					<div class="watch-clock">{{clock}}</div>
					<div class="watch-ends">
						<span data-if="watch_speed != ''" class="badge">{{watch_speed}}</span>
						<span data-if="watch_ends != ''">{{watch_ends}}</span>
					</div>
				</div>
			</div>
			<div class="timeline">
				<span class="tl-state" data-if="watch_paused">⏸</span>
				<span class="tl-state" data-if="!watch_paused">▶</span>
				<span class="tl-pos">{{watch_pos}}</span>
				<div class="tl-track" data-if="watch_seekable">
					<div class="tl-buffered" data-style-width="watch_buffered"/>
					<div class="tl-played" data-style-width="watch_progress"/>
				</div>
				<span class="tl-live" data-if="!watch_seekable">LIVE</span>
				<span class="tl-dur" data-if="watch_dur != ''">{{watch_dur}}</span>
			</div>
		</div>

		<!-- Launching the next track without leaving watch mode. -->
		<div id="launch-overlay" data-if="watching && launch_status != ''">
			<span class="busy-dot busy-dot1"/>
			<span class="busy-dot busy-dot2"/>
			<span class="busy-dot busy-dot3"/>
			<span class="launch-label">{{launch_status}}</span>
		</div>

		<div id="toast" data-if="toast != ''">{{toast}}</div>

		<!-- Screensaver: dims everything after a while without input. -->
		<div id="saver" data-if="saver">
			<div class="saver-box" data-style-left="saver_x" data-style-top="saver_y">
				<div class="saver-clock">{{clock}}</div>
				<div class="saver-date">{{date}}</div>
				<div class="saver-now" data-if="saver_now != ''">{{saver_now}}</div>
			</div>
		</div>

	</body>
</rml>
