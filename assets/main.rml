<rml>
	<head>
		<title>JTPlay</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="theme.rcss"/>
		<link type="text/rcss" href="css/layout.rcss"/>
		<link type="text/rcss" href="css/browse.rcss"/>
		<link type="text/rcss" href="css/watch.rcss"/>
		<link type="text/rcss" href="css/busy.rcss"/>
	</head>
	<body data-model="jtplay" data-class-watching="watching">

		<div id="shell">
			<div id="topbar">
				<img class="brand-logo" src="icons/logo.png"/>
				<span class="brand-label">
				</span>
				<span class="crumb" data-if="view == 'browse'">{{crumb}}</span>
				<span class="busy">
					<span class="busy-dot busy-dot0"/>
					<span class="busy-dot busy-dot1" data-if="busy"/>
					<span class="busy-dot busy-dot2" data-if="busy"/>
					<span class="busy-dot busy-dot3" data-if="busy"/>
				</span>
				<span class="spacer"/>
				<span class="clock">{{clock}}</span>
			</div>

			<!-- ========================== Sources ========================== -->
			<div id="content" data-if="view == 'sources'">
				<div id="sources" class="pane active">
					<div class="pane-head">
						<span class="eyebrow">Media sources</span>
						<span class="count" data-if="source_count > 0">{{source_count}}</span>
					</div>
					<div id="source-list" class="list">
						<div class="source-row" data-for="src : sources"
						     data-class-selected="it_index == sel_source"
						     data-event-click="select_source(it_index)">
							<div class="srcicon">{{src.icon}}</div>
							<div class="srcinfo">
								<div class="srcname">{{src.name}}</div>
								<div class="srcdetail">{{src.detail}}</div>
							</div>
						</div>
						<div class="empty" data-if="source_count == 0 && !busy">
							No media sources found.
						</div>
						<div class="empty" data-if="source_count == 0 && busy">
							Searching for media sources...
						</div>
					</div>
					<div class="status" data-if="status != ''">{{status}}</div>
				</div>
			</div>

			<!-- =========================== Browse ========================== -->
			<div id="content" data-if="view == 'browse'">
				<div id="entries" class="pane active">
					<div class="pane-head">
						<span class="eyebrow">{{source_name}}</span>
						<span class="count" data-if="entry_count > 0">{{entry_count}}</span>
					</div>
					<div id="entry-list" class="list">
						<div class="entry-row" data-for="e : entries"
						     data-class-selected="it_index == sel_entry"
						     data-class-folder="e.folder"
						     data-event-click="select_entry(it_index)">
							<div class="eicon">{{e.icon}}</div>
							<div class="einfo">
								<div class="etitle">{{e.name}}</div>
							</div>
						</div>
						<div class="empty" data-if="entry_count == 0 && !busy">
							This folder is empty.
						</div>
						<div class="empty" data-if="entry_count == 0 && busy">
							Loading...
						</div>
					</div>
				</div>

				<div id="details" class="pane">
					<div class="pane-head">
						<span class="eyebrow">Details</span>
					</div>
					<div class="detail-body" data-if="detail_description != '' || detail_image != ''">
						<div class="detail-desc" data-if="detail_description != ''">{{detail_description}}</div>
						<img class="detail-art" data-if="detail_image != ''" data-attr-src="detail_image"/>
					</div>
				</div>
			</div>

			<div id="footer">
				<span class="chip" data-if="view == 'sources'"><img class="key-icon" src="icons/cross.png"/>&nbsp;Select</span>
				<span class="chip" data-if="view == 'sources'"><img class="key-icon" src="icons/square.png"/>&nbsp;Rescan</span>
				<span class="chip" data-if="view == 'browse'"><img class="key-icon" src="icons/cross.png"/>&nbsp;Select</span>
				<span class="chip" data-if="view == 'browse'"><img class="key-icon" src="icons/circle.png"/>&nbsp;Back</span>
			</div>
		</div>

		<!-- =========================== Watching ========================== -->

		<!-- Audio: persistent now-playing card in the middle of the screen. -->
		<div id="audio-card" data-if="watching && watch_audio">
			<img class="np-art" data-if="watch_image != ''" data-attr-src="watch_image"/>
			<div class="art" data-if="watch_image == ''">🎵</div>
			<div class="np-title">{{watch_name}}</div>
			<div class="np-meta" data-if="watch_description != ''">{{watch_description}}</div>
			<div class="np-atrack" data-if="watch_multi_audio"><img class="key-icon" src="icons/triangle.png"/>&nbsp;{{watch_atrack}}</div>
			<div class="watch-progress" data-if="watch_seekable">
				<div class="bar" data-style-width="watch_progress"/>
			</div>
			<div class="np-time">{{watch_time}}</div>
			<div class="np-state" data-if="watch_paused">PAUSED</div>
		</div>

		<!-- Video: auto-hiding transport bar over the frames. -->
		<div id="watch-bar" data-if="watching && !watch_audio && info_visible">
			<img class="watch-thumb" data-if="watch_image != ''" data-attr-src="watch_image"/>
			<div class="watch-main">
				<div class="watch-name">{{watch_name}}</div>
				<div class="watch-tracks">
					<span class="watch-track" data-if="watch_vtrack != ''">Video: {{watch_vtrack}}</span>
					<span class="watch-track" data-if="watch_atrack != ''">Audio: {{watch_atrack}}</span>
				</div>
				<div class="watch-progress" data-if="watch_seekable">
					<div class="bar" data-style-width="watch_progress"/>
				</div>
			</div>
			<div class="watch-side">
				<div class="watch-time">{{watch_time}}</div>
				<div class="watch-hints">
					<span class="chip" data-if="watch_seekable"><img class="key-icon" src="icons/dpad.png"/>&nbsp;Seek</span>
					<span class="chip" data-if="watch_multi_video"><img class="key-icon" src="icons/square.png"/>&nbsp;Video track</span>
					<span class="chip" data-if="watch_multi_audio"><img class="key-icon" src="icons/triangle.png"/>&nbsp;Audio track</span>
					<span class="chip"><img class="key-icon" src="icons/cross.png"/>&nbsp;Play/Pause</span>
					<span class="chip"><img class="key-icon" src="icons/circle.png"/>&nbsp;Stop</span>
					<span class="chip"><img class="key-icon" src="icons/options.png"/>&nbsp;Info</span>
				</div>
			</div>
		</div>

		<!-- Launching the next track without leaving watch mode. -->
		<div id="launch-overlay" data-if="watching && launch_status != ''">
			<span class="busy-dot busy-dot1"/>
			<span class="busy-dot busy-dot2"/>
			<span class="busy-dot busy-dot3"/>
			<span class="launch-label">{{launch_status}}</span>
		</div>

		<div id="toast" data-if="toast != ''">{{toast}}</div>

	</body>
</rml>
