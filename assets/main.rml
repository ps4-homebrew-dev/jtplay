<rml>
	<head>
		<title>JTPlay</title>
		<link type="text/rcss" href="rml.rcss"/>
		<link type="text/rcss" href="theme.rcss"/>
		<link type="text/rcss" href="css/layout.rcss"/>
		<link type="text/rcss" href="css/home.rcss"/>
		<link type="text/rcss" href="css/browse.rcss"/>
		<link type="text/rcss" href="css/menu.rcss"/>
		<link type="text/rcss" href="css/watch.rcss"/>
		<link type="text/rcss" href="css/busy.rcss"/>
		<link type="text/rcss" href="css/photo.rcss"/>
	</head>
	<body data-model="jtplay" data-class-watching="watching" data-class-photo="photo">

		<!-- Fanart: the focused item's artwork, large and dim, behind it all. -->
		<div id="backdrop" data-if="backdrop != 'none' && !watching" data-style-decorator="backdrop"/>
		<div id="backdrop-shade" data-if="!watching"/>

		<div id="shell">
			<div id="topbar">
				<img class="brand-logo" src="icons/logo.png"/>
				<div class="location">
					<span class="wordmark" data-if="view == 'home'">jtplay</span>
					<span class="location-source" data-if="view == 'browse'">{{source_name}}</span>
					<span class="location-path" data-if="view == 'browse' && crumb != ''">›  {{crumb}}</span>
				</div>
				<span class="busy">
					<span class="busy-dot busy-dot0"/>
					<span class="busy-dot busy-dot1" data-if="busy"/>
					<span class="busy-dot busy-dot2" data-if="busy"/>
					<span class="busy-dot busy-dot3" data-if="busy"/>
				</span>
				<div class="clockbox">
					<div class="clock">{{clock}}</div>
					<div class="date">{{date}}</div>
				</div>
			</div>

			<!-- ============================ Home =========================== -->
			<div id="home" class="content" data-if="view == 'home'">
				<div id="rail" data-class-away="home_shelves">
					<div class="rail-row" data-for="r, ri : rail"
					     data-class-selected="ri == sel_rail">
						<span class="rail-icon">{{r.icon}}</span>
						<div class="rail-text">
							<div class="rail-label">{{r.label}}</div>
							<div class="rail-detail" data-if="r.detail != ''">{{r.detail}}</div>
						</div>
					</div>
				</div>

				<div id="home-main">
					<div id="hero" data-if="hero_title != ''">
						<div class="hero-icon">{{hero_icon}}</div>
						<div class="hero-text">
							<div class="hero-title">{{hero_title}}</div>
							<div class="hero-detail" data-if="hero_detail != ''">{{hero_detail}}</div>
							<div class="hero-note" data-if="hero_note != ''">{{hero_note}}</div>
						</div>
					</div>

					<div id="shelves" data-class-active="home_shelves">
						<div class="shelf" data-for="sh, si : shelves"
						     data-class-current="si == sel_shelf">
							<div class="shelf-head">
								<span class="shelf-title">{{sh.title}}</span>
								<span class="shelf-count">{{sh.cards.size}}</span>
							</div>
							<div class="cards" data-attr-id="'cards-' + si">
								<div class="card" data-for="c, ci : sh.cards"
								     data-class-selected="home_shelves && si == sel_shelf && ci == sel_card">
									<div class="art-tile"
									     data-class-k-folder="c.kind == 'folder'"
									     data-class-k-audio="c.kind == 'audio'"
									     data-class-k-video="c.kind == 'video'"
									     data-class-k-image="c.kind == 'image'">
										<div class="art-img" data-if="c.art != 'none'" data-style-decorator="c.art"/>
										<div class="art-glyph" data-if="c.art == 'none'">{{c.glyph}}</div>
										<span class="art-check" data-if="c.watched">✔</span>
										<div class="art-prog" data-if="c.progress != '0%'">
											<div class="art-prog-bar" data-style-width="c.progress"/>
										</div>
									</div>
									<div class="card-title">{{c.title}}</div>
									<div class="card-sub">{{c.subtitle}}</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- =========================== Browse ========================== -->
			<div id="browse" class="content" data-if="view == 'browse'"
			     data-class-grid="view_mode == 'grid'">
				<div id="entries" class="pane">
					<div class="pane-head">
						<span class="eyebrow">{{entry_count}} items</span>
						<span class="spacer"/>
						<span class="sort">{{sort_label}}</span>
						<span class="position" data-if="entry_count > 0">{{sel_entry + 1}} / {{entry_count}}</span>
					</div>
					<!-- The letter a left / right jump landed on, briefly and large. -->
					<div id="jump-letter" data-if="jump_letter != ''">{{jump_letter}}</div>
					<div id="entry-list" class="list">
						<div class="entry-row" data-for="e : entries"
						     data-class-selected="it_index == sel_entry">
							<div class="art-tile"
							     data-class-k-folder="e.kind == 'folder'"
							     data-class-k-audio="e.kind == 'audio'"
							     data-class-k-video="e.kind == 'video'"
							     data-class-k-image="e.kind == 'image'">
								<div class="art-img" data-if="e.art != 'none'" data-style-decorator="e.art"/>
								<div class="art-glyph" data-if="e.art == 'none'">{{e.icon}}</div>
								<span class="art-check" data-if="e.watched">✔</span>
								<span class="art-fav" data-if="e.favorite">⭐</span>
								<div class="art-prog" data-if="e.progress != '0%'">
									<div class="art-prog-bar" data-style-width="e.progress"/>
								</div>
							</div>
							<div class="etitle" data-class-folder="e.folder">{{e.name}}</div>
							<span class="emark" data-if="e.favorite">⭐</span>
							<span class="emark watched" data-if="e.watched">✔</span>
							<div class="emeta" data-if="e.meta != ''">{{e.meta}}</div>
						</div>
						<div class="empty" data-if="entry_count == 0 && !busy">
							This folder is empty.
						</div>
						<div class="empty" data-if="entry_count == 0 && busy">
							Loading...
						</div>
					</div>
					<!-- Grid: what the focused tile is, along the bottom. -->
					<div id="grid-info" data-if="view_mode == 'grid' && detail_name != ''">
						<div class="gi-title"><span class="detail-fav" data-if="detail_favorite">⭐ </span>{{detail_name}}</div>
						<div class="gi-props">
							<span class="gi-prop" data-for="p : detail_props">{{p.value}}</span>
						</div>
					</div>
				</div>

				<div id="details" class="pane">
					<div class="detail-body" data-if="detail_name != ''">
						<div class="detail-artbox">
							<img class="detail-art" data-if="detail_image != ''" data-attr-src="detail_image"/>
							<div class="detail-glyph" data-if="detail_image == ''">{{detail_icon}}</div>
						</div>
						<div class="detail-title"><span class="detail-fav" data-if="detail_favorite">⭐ </span>{{detail_name}}</div>
						<div class="detail-props">
							<div class="prop" data-for="p : detail_props">
								<span class="prop-label">{{p.label}}</span>
								<span class="prop-value">{{p.value}}</span>
							</div>
						</div>
						<div class="detail-desc" data-if="detail_description != ''">{{detail_description}}</div>
					</div>
				</div>
			</div>
		</div>

		<!-- ======================== Playback OSD ========================= -->

		<!-- Paused video: a large badge in the middle, Kodi style. -->
		<div id="pause-badge" data-if="watching && watch_paused && !watch_audio && !menu_open">⏸</div>

		<!-- The bar along the bottom. Its top edge is the timeline: played,
		     buffered ahead, and a knob at the playhead. Video: auto-hides.
		     Audio: stays, with large cover art, over the spectrum. -->
		<div id="osd" data-if="watching && !watch_audio && info_visible">
			<div class="osd-edge" data-if="watch_seekable">
				<div class="osd-buffered" data-style-width="watch_buffered"/>
				<div class="osd-played" data-style-width="watch_progress"/>
				<div class="osd-chapter-mark" data-for="cm : chapter_marks" data-style-left="cm.at"/>
				<div class="osd-knob" data-style-left="watch_progress"/>
				<div class="osd-seek" data-if="watch_seek != ''" data-style-left="watch_seek_at">{{watch_seek}}</div>
			</div>
			<div class="osd-row">
				<img class="osd-art" data-if="watch_image != ''" data-attr-src="watch_image"/>
				<div class="osd-main">
					<div class="osd-title">
						<span class="osd-state" data-if="watch_paused">⏸</span>
						<span class="osd-state" data-if="!watch_paused">▶</span>
						{{watch_name}}
					</div>
					<div class="osd-desc" data-if="watch_description != ''">{{watch_description}}</div>
					<div class="osd-chapter" data-if="watch_chapter != ''">{{watch_chapter}}</div>
					<div class="osd-tracks">
						<span class="osd-track" data-if="watch_vtrack != ''">{{watch_vtrack}}</span>
						<span class="osd-track" data-if="watch_atrack != ''">{{watch_atrack}}</span>
						<span class="osd-track osd-modes" data-if="watch_modes != ''">{{watch_modes}}</span>
					</div>
					<div class="osd-next" data-if="watch_next != ''">
						<span class="osd-next-label">UP NEXT</span>{{watch_next}}
					</div>
				</div>
				<div class="osd-side">
					<div class="osd-time">
						<span>{{watch_pos}}</span>
						<span data-if="watch_dur != ''"> / {{watch_dur}}</span>
						<span class="osd-live" data-if="!watch_seekable">LIVE</span>
					</div>
					<div class="osd-speed" data-if="watch_speed != ''">
						<span class="badge">{{watch_speed}}</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Audio: the now-playing card, over the visualizer the player draws
		     underneath (src/visualizer.cpp). Always up. -->
		<div id="np-card" data-if="watching && watch_audio">
			<div class="np-artbox">
				<img class="np-art" data-if="watch_image != ''" data-attr-src="watch_image"/>
				<div class="np-glyph" data-if="watch_image == ''">🎵</div>
			</div>
			<div class="np-title">{{watch_name}}</div>
			<div class="np-meta" data-if="watch_description != ''">{{watch_description}}</div>
			<div class="np-track" data-if="watch_atrack != ''">{{watch_atrack}}</div>
			<div class="np-progress" data-if="watch_seekable">
				<div class="np-buffered" data-style-width="watch_buffered"/>
				<div class="np-played" data-style-width="watch_progress"/>
				<div class="np-chapter-mark" data-for="cm : chapter_marks" data-style-left="cm.at"/>
				<div class="np-knob" data-style-left="watch_progress"/>
			</div>
			<div class="np-status">
				<span class="np-state" data-if="watch_paused">⏸</span>
				<span class="np-state" data-if="!watch_paused">▶</span>
				<span>{{watch_pos}}</span>
				<span data-if="watch_dur != ''"> / {{watch_dur}}</span>
				<span class="np-live" data-if="!watch_seekable">LIVE</span>
				<span class="badge" data-if="watch_speed != ''">{{watch_speed}}</span>
				<span class="np-modes" data-if="watch_modes != ''">{{watch_modes}}</span>
			</div>
			<div class="np-chapter" data-if="watch_chapter != ''">{{watch_chapter}}</div>
			<div class="np-seek" data-if="watch_seek != ''">{{watch_seek}}</div>
			<div class="np-next" data-if="watch_next != ''">
				<span class="np-next-label">UP NEXT</span>{{watch_next}}
			</div>
		</div>

		<!-- Up next: over the end of an episode, counting down to the next. -->
		<div id="upnext" data-if="watching && upnext && !menu_open">
			<div class="upnext-art">
				<div class="upnext-img" data-if="upnext_art != 'none'" data-style-decorator="upnext_art"/>
				<div class="upnext-glyph" data-if="upnext_art == 'none'">🎬</div>
			</div>
			<div class="upnext-text">
				<div class="upnext-label">UP NEXT</div>
				<div class="upnext-name">{{upnext_name}}</div>
				<div class="upnext-count">{{upnext_count}}</div>
				<div class="upnext-keys">Select to play now, back to stay</div>
			</div>
		</div>
		
		<!-- The clock in the corner while the OSD is up. -->
		<div id="osd-clock" data-if="watching && (watch_audio || info_visible)">{{clock}}</div>

		<!-- Launching the next track without leaving watch mode. -->
		<div id="launch-overlay" data-if="watching && launch_status != ''">
			<span class="busy-dot busy-dot1"/>
			<span class="busy-dot busy-dot2"/>
			<span class="busy-dot busy-dot3"/>
			<span class="launch-label">{{launch_status}}</span>
		</div>

		<!-- ======================== Photo viewer ========================= -->
		<!-- Two layers take turns: the new picture fades in on one while the
		     old one is still on the other (src/app_photo.cpp). -->
		<div id="photo" data-if="photo" data-class-fade="photo_fade">
			<div class="photo-turn" data-style-transform="photo_rotate"
			     data-class-sideways="photo_sideways">
				<div class="photo-layer" data-class-front="photo_front == 0"
				     data-style-decorator="photo_art0" data-style-animation="photo_anim0"/>
				<div class="photo-layer" data-class-front="photo_front == 1"
				     data-style-decorator="photo_art1" data-style-animation="photo_anim1"/>
			</div>
			<div class="photo-loading" data-if="photo_loading">
				<span class="busy-dot busy-dot1"/>
				<span class="busy-dot busy-dot2"/>
				<span class="busy-dot busy-dot3"/>
			</div>
			<div class="photo-caption" data-if="photo_info">
				<span class="photo-state" data-if="photo_playing">▶</span>
				<div class="photo-text">
					<div class="photo-name">{{photo_name}}</div>
					<div class="photo-meta">{{photo_meta}}</div>
				</div>
				<div class="photo-clock">{{clock}}</div>
			</div>
		</div>

		<!-- ===================== Menus and dialogs ======================= -->
		<div id="menu-scrim" data-if="menu_open"/>
		<div id="menu" data-if="menu_open" data-class-dialog="menu_dialog">
			<div class="menu-title">{{menu_title}}</div>
			<div id="menu-rows">
				<div class="menu-row" data-for="m : menu"
				     data-class-selected="it_index == sel_menu">
					<span class="menu-label">{{m.label}}</span>
					<span class="menu-value" data-if="m.value != ''">‹  {{m.value}}  ›</span>
				</div>
			</div>
		</div>

		<!-- Notification in the corner. -->
		<div id="toast" data-if="toast != ''">
			<span class="toast-icon">{{toast_icon}}</span>
			<span class="toast-text">{{toast}}</span>
		</div>

		<!-- Screensaver: dims everything after a while without input. -->
		<div id="saver" data-if="saver">
			<div class="saver-box" data-style-left="saver_x" data-style-top="saver_y">
				<div class="saver-clock">{{clock}}</div>
				<div class="saver-date">{{date}}</div>
				<div class="saver-now" data-if="saver_now != ''">{{saver_now}}</div>
			</div>
		</div>

	</body>
</rml>
